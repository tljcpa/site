---
import { getCollection } from "astro:content";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const projects = await getCollection("project", ({ data }) =>
	import.meta.env.PROD ? !data.draft : true,
);
const posts = await getAllPosts();

// 旗舰项目(唯一)
const flagship = projects.find((p) => p.data.flagship);

// 合规旗舰的深度复盘系列,按逻辑顺序(不是时间)
const complianceOrder = [
	"compliance-dataset-from-scratch",
	"compliance-dataset-engineering",
	"finetune-six-experiments",
	"distributed-finetune-8gpu",
	"finetune-misleading-metrics",
	"compliance-eval-methodology",
	"compliance-pitfalls-reference",
];
const complianceSeries = complianceOrder
	.map((id) => posts.find((p) => p.id === id))
	.filter((p) => p !== undefined);

// 主线:具身智能(embodied 系列),按 weight;实机/实习类优先
const embodied = projects
	.filter((p) => p.data.series === "embodied")
	.sort((a, b) => b.data.weight - a.data.weight);
const embodiedReal = embodied.filter((p) => p.data.kind === "实习");
const embodiedOther = embodied.filter((p) => p.data.kind !== "实习");
const embodiedOrder = ["vla-action-tokenization", "qlora-memory-budget"];
const embodiedPosts = embodiedOrder
	.map((id) => posts.find((p) => p.id === id))
	.filter((p) => p !== undefined);

// 其他精选(排除具身系列与旗舰)
const featured = projects.filter((p) => p.data.featured && p.data.series !== "embodied" && !p.data.flagship);
---

<PageLayout meta={{ title: "首页" }}>
	{/* 定位 */}
	<section>
		<h1 class="title mb-4 text-2xl sm:text-3xl">tlj · 具身智能算法</h1>
		<p class="text-muted mb-4">
			我做具身智能算法，偏落地那一侧。最近主要在折腾 VLA：π0.5 在双臂机械臂上怎么用人工接管的数据接着训，π0 在国产卡上能不能续训起来，ACT 和人形运控在比赛里跑到什么程度。为了让模型有数据可学，遥操作采集、灵巧手、板子上的驱动也都自己上手弄过。
		</p>
		<p class="text-muted mb-4 text-sm">
			再往前是做大模型微调和评估。这里记的是每个项目实际做到哪了、卡在哪，没跑出数的就写没跑出来。
		</p>
		<SocialList />
		<p class="text-muted mt-4 text-sm">
			北京 · 想交流或提建议，写信 <a href="mailto:zdwktlj@outlook.com" class="text-accent hover:underline">zdwktlj@outlook.com</a> / <a href="mailto:zdwktlj@gmail.com" class="text-accent hover:underline">zdwktlj@gmail.com</a>，或在任意文章里划线给我留言。
		</p>
	</section>

	{/* 具身智能主线 */}
	{
		embodied.length > 0 && (
			<section class="mt-14">
				<h2 class="title mb-1 text-lg">具身智能</h2>
				<p class="text-muted mb-5 text-sm">先放真机上做的，比赛和复现在后面。</p>
				<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2" role="list">
					{embodiedReal.map((p) => (
						<li class="border-muted/40 hover:border-accent flex flex-col rounded-md border p-4 transition-colors">
							<a href={`/projects/${p.id}/`} class="text-accent mb-1 font-semibold hover:underline">
								{p.data.title}
							</a>
							{p.data.highlight && <p class="text-muted text-sm">{p.data.highlight}</p>}
						</li>
					))}
				</ul>
				{embodiedOther.length > 0 && (
					<div class="mt-6">
						<h3 class="text-muted mb-2 text-sm font-semibold">比赛与复现</h3>
						<ul class="space-y-1.5" role="list">
							{embodiedOther.map((p) => (
								<li class="text-sm">
									<span class="text-muted mr-1">·</span>
									<a href={`/projects/${p.id}/`} class="text-accent hover:underline">{p.data.title}</a>
								</li>
							))}
						</ul>
					</div>
				)}
				{embodiedPosts.length > 0 && (
					<div class="mt-6">
						<h3 class="text-muted mb-2 text-sm font-semibold">笔记</h3>
						<ul class="space-y-1.5" role="list">
							{embodiedPosts.map((p) => (
								<li class="text-sm">
									<span class="text-muted mr-1">·</span>
									<a href={`/posts/${p.id}/`} class="text-accent hover:underline">{p.data.title}</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		)
	}

	{/* 旗舰 */}
	{
		flagship && (
			<section class="mt-14">
				<h2 class="title mb-4 text-lg">之前做的：合规质检模型微调（实习）</h2>
				<a
					href={`/projects/${flagship.id}/`}
					class="border-accent/40 hover:border-accent block rounded-lg border-2 p-6 transition-colors"
				>
					<h3 class="text-accent mb-2 text-xl font-bold">{flagship.data.title}</h3>
					<p class="text-muted mb-3 text-sm">{flagship.data.description}</p>
					{flagship.data.highlight && (
						<p class="mb-3 text-sm">
							<span class="text-accent">→ </span>
							{flagship.data.highlight}
						</p>
					)}
					{flagship.data.stack.length > 0 && (
						<ul class="flex flex-wrap gap-1.5" role="list">
							{flagship.data.stack.map((tech) => (
								<li class="bg-accent/10 text-muted rounded px-1.5 py-0.5 text-xs">{tech}</li>
							))}
						</ul>
					)}
				</a>
				{complianceSeries.length > 0 && (
					<div class="border-accent/30 mt-4 border-l-2 pl-4">
						<p class="text-muted mb-2 text-xs">
							围绕这个项目的 {complianceSeries.length} 篇复盘，从数据、训练、评估到踩坑：
						</p>
						<ul class="space-y-1.5" role="list">
							{complianceSeries.map((p, i) => (
								<li class="text-sm">
									<span class="text-muted mr-1">{i + 1}.</span>
									<a href={`/posts/${p.id}/`} class="text-accent hover:underline">
										{p.data.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		)
	}

	{/* 精选其他 */}
	{
		featured.length > 0 && (
			<section class="mt-14">
				<h2 class="title mb-4 text-lg">其他精选项目</h2>
				<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2" role="list">
					{featured.map((p) => (
						<li class="border-muted/40 hover:border-accent flex flex-col rounded-md border p-4 transition-colors">
							<a href={`/projects/${p.id}/`} class="text-accent mb-1 font-semibold hover:underline">
								{p.data.title}
							</a>
							<p class="text-muted text-sm">{p.data.description}</p>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{/* 入口 */}
	<section class="border-muted/30 mt-14 flex gap-6 border-t pt-6 text-sm">
		<a href="/projects/" class="text-accent hover:underline">全部项目 &rarr;</a>
		<a href="/posts/" class="text-accent hover:underline">全部博客 &rarr;</a>
	</section>
</PageLayout>
